    },
    {
      "key": "enableSoulAbsorption",
      "type": "boolean",
      "default": false,
      "description": "Whether players can absorb permanent morphs for account-bound permanence.",
      "example": true,
      "category": "permanent-morphs"
    },
    {
      "key": "elderGuardianMiningFatigueRadius",
      "type": "number",
      "default": 50.0,
      "description": "Elder Guardian active ability radius in blocks.",
      "example": 32.0,
      "category": "abilities"
    },
    {
      "key": "elderGuardianMiningFatigueDurationTicks",
