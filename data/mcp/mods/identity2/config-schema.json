    {
      "key": "defaultPermanentKillRequirement",
      "type": "integer",
      "default": 250,
      "description": "Default kills required to permanently bind a stored morph.",
      "example": 100,
      "category": "permanent-morphs"
    },
    {
      "key": "permanentKillRequirementByIdentity",
      "type": "string-list",
      "default": [],
      "description": "Per-identity permanent requirement overrides in the format namespace:entity=value.",
