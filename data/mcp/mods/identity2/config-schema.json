      "key": "elderGuardianMiningFatigueCooldownTicks",
      "type": "integer",
      "default": 600,
      "description": "Elder Guardian active ability cooldown in ticks. Set to 0 to use datapack cooldown.",
      "example": 0,
      "category": "abilities"
    },
    {
      "key": "shulkerTeleportCooldownTicks",
      "type": "integer",
      "default": 80,
      "description": "Shulker secondary teleport cooldown in ticks.",
      "example": 40,
      "category": "abilities"
    },
    {
