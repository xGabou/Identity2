      "category": "soul-jars"
    },
    {
      "key": "soulJarWorldDropTierWeights",
      "type": "string-list",
      "default": [
        "mud=85",
        "glass=12",
        "reinforced=3",
        "true_soul=1"
      ],
      "description": "Weighted random jar tiers for world drops in the format tier=weight.",
      "example": [
        "mud=80",
        "glass=15",
        "reinforced=4",
        "true_soul=1"
      ],
      "category": "soul-jars"
    },
    {
      "key": "enablePermanentMorphs",
      "type": "boolean",
      "default": false,
      "description": "Whether stored morphs can become permanent by kill dedication.",
      "example": true,
